{
  "manifest_version": 3,
  "name": "Bury AI",
  "version": "0.5.0",
  "description": "Blocks AI Overview & AI Mode on Google and AI summaries on DuckDuckGo search results.",
  "icons": {
    "128": "icons/bury-ai-icon-128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.google.com/*", "*://*.duckduckgo.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  }
}
