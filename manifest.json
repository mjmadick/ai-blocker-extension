{
  "manifest_version": 3,
  "name": "AI Blocker for Google Search",
  "version": "0.3.0",
  "description": "Suppresses Google's AI Overview and AI Mode in search results.",
  "icons": {
    "128": "icons/bury-ai-icon-128.png"
  },
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": ["*://*.google.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  }
}
