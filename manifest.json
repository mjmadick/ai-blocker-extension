{
  "manifest_version": 3,
  "name": "AI Blocker for Search Engines",
  "version": "0.2.0",
  "description": "Suppresses AI-generated overviews in Google and Bing search results.",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": ["*://*.google.com/*", "*://*.bing.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  }
}
